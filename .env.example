NODE_ENV=development
GMAIL_USER=your-sending-mailbox@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
PORT=3000
# Cloudflare's documented always-pass test secret. Replace it in production.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Set only when the app is behind a trusted proxy that overwrites X-Forwarded-For.
TRUST_PROXY=false
